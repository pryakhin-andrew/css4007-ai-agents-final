# Configure your chosen provider locally. Never commit real credentials.
# Default provider is OpenRouter (OpenAI-compatible API, many models via one key).
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# Discord bot (separate bot account, not your personal account)
DISCORD_BOT_TOKEN=
APPROVER_DISCORD_ID=

# Google Sheets with the student roster (service account, read-only)
GOOGLE_SERVICE_ACCOUNT_FILE=
STUDENTS_SHEET_ID=

# Bitlab portal (read-only task context)
BITLAB_API_BASE=
BITLAB_API_TOKEN=

# Agent execution limits
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_RETRIES=2
